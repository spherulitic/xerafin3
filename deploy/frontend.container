[Unit]
Description=Xerafin Front End
After=keycloak.service
After=stats.service
After=sloth.service
After=cardbox.service
After=login.service
After=quiz.service
After=chat.service
After=lexicon.service
# Wants+After preserves boot activation/order without propagating stop or
# restart: restarting a backend must not take nginx down.
Wants=keycloak.service
Wants=stats.service
Wants=sloth.service
Wants=cardbox.service
Wants=login.service
Wants=quiz.service
Wants=chat.service
Wants=lexicon.service
PartOf=xerafin.target
# Keep retrying: a transient start failure must not leave the site dead.
StartLimitIntervalSec=0

After=xerafin-network.service
Requires=xerafin-network.service

[Container]
ContainerName=frontend
Image=x-frontend:latest

PublishPort=7080:80
PublishPort=7443:443

# Network settings for service discovery
Network=systemd-xerafin
NetworkAlias=frontend

# Local dev certs; CI rewrites this to the prod Let's Encrypt files on deploy
Volume=/home/spherulitic/xerafin3/frontend/ssl/dev:/etc/nginx/ssl:ro

# Mounted volume to store user photos
Volume=/var/lib/xerafin/user-photos:/usr/share/nginx/html/images/users:rw,U

# Ensure the correct runtime and conmon are used
Environment=CONTAINER_CONMON=/usr/local/bin/conmon
PodmanArgs=--runtime=/home/linuxbrew/.linuxbrew/bin/crun

[Service]
Restart=always
RestartSec=5
# Headroom for an image pull or a slow nginx start.
TimeoutStartSec=300

[Install]
WantedBy=xerafin.target
